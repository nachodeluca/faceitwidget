{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://faceitwidget.com",
          "http://localhost:3000",
          "http://127.0.0.1:3000",
          "http://localhost:8787",
          "http://127.0.0.1:8787"
        ],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": [
          "Content-Type",
          "Origin",
          "x-amz-meta-nickname",
          "x-amz-meta-owner",
          "x-amz-meta-widget-instance"
        ]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
