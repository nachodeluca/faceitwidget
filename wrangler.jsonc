{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "faceitwidget",
  "main": "backend/index.ts",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "faceitwidget.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PLAYER_SNAPSHOTS",
        "class_name": "PlayerSnapshotCoordinator"
      },
      {
        "name": "SHARED_WIDGETS",
        "class_name": "SharedWidgetCard"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "USER_BACKGROUNDS",
      "bucket_name": "faceitwidget-user-backgrounds",
      "remote": true
    }
  ],
  "exports": {
    "PlayerSnapshotCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "SharedWidgetCard": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "PLAYER_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "SHARE_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "BACKGROUND_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    "LIVE_POLL_INTERVAL_MS": "30000",
    "R2_BUCKET_NAME": "faceitwidget-user-backgrounds",
    "R2_PUBLIC_BASE_URL": "https://assets.faceitwidget.com"
  },
  "observability": {
    "enabled": true
  }
}
